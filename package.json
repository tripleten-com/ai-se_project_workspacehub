{
  "name": "workspacehub",
  "private": true,
  "version": "1.0.0",
  "workspaces": [
    "client",
    "server"
  ],
  "scripts": {
    "dev:client": "npm run dev --workspace client",
    "dev:server": "npm run dev --workspace server",
    "build": "npm run build --workspace server && npm run build --workspace client",
    "typecheck": "npm run typecheck --workspace client && npm run typecheck --workspace server",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "seed": "npm run seed --workspace server"
  },
  "devDependencies": {
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^9.1.2",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.5.8",
    "globals": "^15.15.0",
    "prettier": "^3.10.1",
    "typescript-eslint": "^8.73.0"
  }
}
